# v2: sysbench oltp_read_write-style transactional workload
BENCH_TABLE_ROWS=10000000
BENCH_THREADS=4
BENCH_WARMUP_TXNS=20
BENCH_TXNS_PER_THREAD=10000
BENCH_RANGE_SIZE=100
BENCH_SEED=42
# 0 = events mode (BENCH_TXNS_PER_THREAD per worker); >0 = run each rung for
# this many seconds instead (fixed-duration mode).
BENCH_DURATION_S=0
# One-time read-only sysbench warm-up per sweep (seconds), run by the harness
# after the data load, before rung 1 — in BOTH modes. 0 disables it.
BENCH_SYSBENCH_WARMUP_S=900
# Used by the harness sweep (not by the benchmark programs):
BENCH_THREADS_LIST="4 8 16 32 64 128 256 512"

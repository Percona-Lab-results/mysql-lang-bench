# v3: four micro-workloads (select with BENCH_WORKLOAD 1..4), per-worker counts.
BENCH_WORKLOAD=1
BENCH_THREADS=4
BENCH_SEED=42
BENCH_INT_ROWS=100000
BENCH_INT_BATCH=10
BENCH_BLOB_COUNT=20
BENCH_BLOB_SIZE=1048576
# Progress checkpoint cadence (seconds) for kill/long-run recovery.
BENCH_PROGRESS_SEC=5
# Harness sweep settings:
BENCH_THREADS_LIST="4 8 16 32 64 128 256 512"
# Workloads to run, in order (1 insert ints, 2 read ints, 3 insert blobs, 4 read blobs).
BENCH_WORKLOADS="1 2 3 4"

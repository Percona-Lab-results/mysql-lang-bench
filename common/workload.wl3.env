# WL3-only re-run (blob insert + MD5). Same counts as common/workload.env, but
# BENCH_WORKLOADS restricted to 3 so a sweep runs only the blob-insert workload.
# Used to re-measure a host after a disk fix (e.g. 10.30.2.30 back on NVMe).
BENCH_WORKLOAD=3
BENCH_THREADS=4
BENCH_SEED=42
BENCH_INT_ROWS=100000
BENCH_INT_BATCH=10
BENCH_BLOB_COUNT=20
BENCH_BLOB_SIZE=1048576
BENCH_PROGRESS_SEC=5
BENCH_THREADS_LIST="4 8 16 32 64 128 256 512"
BENCH_WORKLOADS="3"

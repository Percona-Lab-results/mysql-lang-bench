# WL1+WL2 re-run for one language. WL2 (fetch+sum) reads what WL1 just inserted
# at the same worker count, so both must run together — the harness recreates
# the schema (empty tables) at sweep start, so WL2 alone would read nothing.
BENCH_WORKLOAD=1
BENCH_THREADS=4
BENCH_SEED=42
BENCH_INT_ROWS=100000
BENCH_INT_BATCH=10
BENCH_BLOB_COUNT=20
BENCH_BLOB_SIZE=1048576
BENCH_PROGRESS_SEC=5
BENCH_THREADS_LIST="4 8 16 32 64 128 256 512"
BENCH_WORKLOADS="1 2"

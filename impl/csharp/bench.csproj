<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>bench</AssemblyName>
    <RootNamespace>Bench</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- GC mode is intentionally NOT pinned here so it can be chosen at runtime
         via the DOTNET_gcServer env var: run.sh exports DOTNET_gcServer=1 for the
         tuned (server GC) variant and DOTNET_gcServer=0 for the stock (workstation
         GC) variant, driven by BENCH_TUNED. Server GC gives per-core heaps +
         parallel collection instead of the single-threaded workstation GC that
         stop-the-world-pauses every worker and collapses throughput past ~64
         workers. Concurrent GC stays enabled (its runtime knob is DOTNET_gcConcurrent). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the DriverVersion const in Bench.cs in sync with this version. -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

</Project>
